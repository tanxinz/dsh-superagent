/** Trusted, synchronous delivery and recovery of bounded Session safety facts. */
import { MeshAccessDenied, type TrustedIdentityAuthority } from './auth.ts'
import { LocalSafetyGate, type PermissionSet, type SafetyBinding } from './safety.ts'
import type { MeshSecurityStore } from './security-store.ts'

export interface ManagedSessionTarget { readonly permissions: PermissionSet; readonly parentSessionId?: string }

/** Targets and scopes come only from the Runtime's managed Session registry, never request JSON. */
export class SessionBindingAuthority {
  constructor(private readonly identities: TrustedIdentityAuthority, private readonly facts: MeshSecurityStore,
    private readonly gate: LocalSafetyGate, private readonly target: (id: string) => ManagedSessionTarget | undefined,
    private readonly now = () => Date.now()) {}

  issue(context: unknown, sessionId: string): SafetyBinding {
    const trusted = this.identities.require(context, 'admin')
    try {
      return this.facts.atomic(() => {
        this.identities.require(context, 'admin')
        const target = this.target(sessionId)
        if (!target) throw new MeshAccessDenied()
        const existing = this.facts.binding(sessionId)
        if (existing) {
          this.restore(context, sessionId)
          if (existing.actorRef !== trusted.actorRef || existing.parentSessionId !== target.parentSessionId
            || JSON.stringify(existing.trusted) !== JSON.stringify(target.permissions)) throw new MeshAccessDenied()
          return existing // no silent renewal, reparenting or widening on restart/retry
        }
        const identity = this.facts.identity(trusted.tenantId, trusted.actorRef)!
        const policy = this.facts.policy(trusted.tenantId)!
        const parents = target.parentSessionId === undefined ? [] : this.gate.bindings(target.parentSessionId)
        if (parents.some(parent => parent.tenantId !== trusted.tenantId || parent.sessionId === sessionId)) throw new MeshAccessDenied()
        const narrow = (key: keyof PermissionSet) => {
          const operands = [target.permissions[key], ...parents.flatMap(p => [p.trusted[key], p.current[key]])]
          const deny = [...new Set(operands.flatMap(d => d.deny))]
          return { allow: target.permissions[key].allow.filter(value => operands.every(d => d.allow.includes(value)) && !deny.includes(value)), deny }
        }
        const permissions: PermissionSet = { tools: narrow('tools'), resources: narrow('resources'), environments: narrow('environments') }
        const binding: SafetyBinding = { sessionId, tenantId: trusted.tenantId, actorRef: trusted.actorRef, role: 'admin',
          ...(target.parentSessionId === undefined ? {} : { parentSessionId: target.parentSessionId }),
          expiresAt: Math.min(this.now() + 15 * 60_000, identity.expiresAt, ...parents.map(p => p.expiresAt)),
          identityVersion: identity.version, safetyPolicyVersion: policy.safetyPolicyVersion,
          emergencyRevocationEpoch: policy.emergencyRevocationEpoch, trusted: target.permissions, current: permissions }
        this.facts.bind(binding)
        return this.restore(context, sessionId)
      })
    } catch { return this.denied(trusted.tenantId, trusted.actorRef, trusted.requestId) }
  }

  restore(context: unknown, sessionId: string): SafetyBinding {
    const trusted = this.identities.require(context, 'admin')
    try {
      const target = this.target(sessionId), binding = this.facts.binding(sessionId)
      if (!target || !binding || binding.tenantId !== trusted.tenantId || binding.parentSessionId !== target.parentSessionId
        || JSON.stringify(binding.trusted) !== JSON.stringify(target.permissions)) throw new MeshAccessDenied()
      this.gate.bindings(sessionId)
      return binding
    } catch { return this.denied(trusted.tenantId, trusted.actorRef, trusted.requestId) }
  }

  revoke(context: unknown, sessionId: string): void {
    const trusted = this.identities.require(context, 'admin')
    try { this.facts.revokeBinding(trusted.tenantId, sessionId) }
    catch { return this.denied(trusted.tenantId, trusted.actorRef, trusted.requestId) }
  }

  private denied(tenantId: string, actorRef: string, requestId: string): never {
    try { this.facts.deny(tenantId, actorRef, requestId, 'SESSION_BINDING_DENIED', this.now()) }
    finally { throw new MeshAccessDenied() }
  }
}
import { Context } from '@deepseek-ai/cordis'
import { mkdtempSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { afterEach, beforeEach, expect, it } from 'vitest'
import { Store } from '../src/app/store.ts'
import { registerHttp, type HttpHost } from '../src/app/http.ts'
import { MeshSecurityStore } from '../src/extensions/mesh/security-store.ts'
import { TrustedIdentityAuthority } from '../src/extensions/mesh/auth.ts'
import { LocalSafetyGate } from '../src/extensions/mesh/safety.ts'
import { SessionBindingAuthority } from '../src/extensions/mesh/session-bindings.ts'
import { CognitiveMeshService } from '../src/extensions/mesh/service.ts'
import { MESH_DEPENDENCIES } from '../src/extensions/mesh/contracts.ts'

let root: string, ctx: Context, store: Store, facts: MeshSecurityStore, mesh: CognitiveMeshService
type Handler = (req: unknown, res: unknown) => Promise<void>
let handler: Handler
let saved: number, ready: Promise<void>
beforeEach(() => {
  root = mkdtempSync(join(tmpdir(), 'mesh-management-')); store = new Store(join(root, 'state.sqlite')); facts = new MeshSecurityStore(store)
  facts.grant({ tenantId: 'a', actorRef: 'admin', roles: ['admin'], expiresAt: 2000000, version: 1 })
  facts.setPolicy({ tenantId: 'a', safetyPolicyVersion: 'v1', emergencyRevocationEpoch: 0 })
  ctx = new Context()
  for (const name of MESH_DEPENDENCIES) if (name !== 'webServer') ctx.reflect.provide(name, {})
  ctx.reflect.provide('webServer', { host: '127.0.0.1', port: 3082, register: (route: { handler: Handler }) => { handler = route.handler; return () => {} } })
  const lifetime = new AbortController(), identities = new TrustedIdentityAuthority(facts, token => token === 'key' ? { tenantId: 'a', actorRef: 'admin' } : undefined, lifetime.signal, () => 1000)
  const gate = new LocalSafetyGate(facts, lifetime.signal, () => 1000)
  const bindings = new SessionBindingAuthority(identities, facts, gate, id => id === 'managed' ? { permissions: {
    tools: { allow: ['read'], deny: [] }, resources: { allow: ['fixture'], deny: [] }, environments: { allow: ['SANDBOX'], deny: [] } } } : undefined, () => 1000)
  mesh = new CognitiveMeshService(ctx, { authority: identities, bindings, lifetime: lifetime.signal })
  saved = 0; ready = Promise.resolve()
})
afterEach(async () => { await ctx.fiber.dispose(); store.close(); rmSync(root, { recursive: true, force: true }) })
function mount() {
  registerHttp(ctx, { get ready() { return ready }, store: { tickets: { get: () => undefined } },
    settings: { pause: async () => { saved++; return {} } } } as unknown as HttpHost)
}
async function call(path: string, body: unknown = {}, duringBody = () => {}, token = 'key') {
  let status = 0, text = ''
  await handler({ method: 'POST', url: '/orchestrator/api/' + path,
    headers: { host: '127.0.0.1:3082', 'x-orchestrator-request': '1', authorization: 'Bearer ' + token },
    async *[Symbol.asyncIterator]() { duringBody(); yield Buffer.from(JSON.stringify(body)) } },
  { writeHead: (value: number) => { status = value }, end: (value: string) => { text = value } })
  return { status, body: JSON.parse(text) as Record<string, unknown> }
}
it('delivers only server-selected bindings via authenticated HTTP and keeps tombstones across retries', async () => {
  mount()
  expect(await call('mesh/sessions/managed/issue')).toMatchObject({ status: 200, body: { sessionId: 'managed', tenantId: 'a', expiresAt: 901000 } })
  expect(await call('mesh/sessions/managed/restore')).toMatchObject({ status: 200 })
  expect(await call('mesh/sessions/managed/revoke')).toEqual({ status: 200, body: { revoked: true } })
  expect(await call('mesh/sessions/managed/issue')).toEqual({ status: 401, body: { error: 'Access denied' } })
})
it('rejects identity and scope input, and authenticates before disclosing the target', async () => {
  mount()
  expect((await call('mesh/sessions/managed/issue', { tenantId: 'other' })).status).toBe(401)
  expect((await call('mesh/sessions/managed/issue', { tools: ['bash'] })).status).toBe(400)
  for (const id of ['managed', 'unknown']) expect(await call(`mesh/sessions/${id}/issue`, {}, () => {}, 'wrong'))
    .toEqual({ status: 401, body: { error: 'Access denied' } })
  expect(facts.binding('managed')).toBeUndefined()
})
it('keeps the original request context across body reads; revocation cannot reauthenticate the same request', async () => {
  mount()
  const result = await call('executor/pause', { paused: true }, () => facts.setPolicy({ tenantId: 'a', safetyPolicyVersion: 'v1', emergencyRevocationEpoch: 1 }))
  expect(result).toEqual({ status: 401, body: { error: 'Access denied' } }); expect(saved).toBe(0)
  expect((await call('executor/pause', { paused: true })).status).toBe(200); expect(saved).toBe(1)
})
it('rechecks the original context after startup and rejects retained authorization on dependency loss', async () => {
  let release!: () => void
  ready = new Promise<void>(resolve => { release = resolve }); mount()
  const pending = call('executor/pause', { paused: true })
  facts.setPolicy({ tenantId: 'a', safetyPolicyVersion: 'v1', emergencyRevocationEpoch: 1 }); release()
  expect((await pending).status).toBe(401); expect(saved).toBe(0)
  const authorization = mesh.authorizeRequest('key')
  await ctx.fiber.dispose()
  expect(() => authorization.check()).toThrow('CognitiveMesh unavailable')
})
import { mkdtempSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { afterEach, beforeEach, expect, it } from 'vitest'
import { Store } from '../src/app/store.ts'
import { MeshSecurityStore } from '../src/extensions/mesh/security-store.ts'
import { TrustedIdentityAuthority, MeshAccessDenied } from '../src/extensions/mesh/auth.ts'
import { LocalSafetyGate } from '../src/extensions/mesh/safety.ts'
import { SessionBindingAuthority, type ManagedSessionTarget } from '../src/extensions/mesh/session-bindings.ts'

let directory: string, file: string, store: Store, facts: MeshSecurityStore, clock: number
let identities: TrustedIdentityAuthority, gate: LocalSafetyGate, bindings: SessionBindingAuthority
let lifetime: AbortController, targets: Map<string, ManagedSessionTarget>
const target = (parentSessionId?: string): ManagedSessionTarget => ({ ...(parentSessionId ? { parentSessionId } : {}),
  permissions: { tools: { allow: ['read'], deny: [] }, resources: { allow: ['fixture'], deny: [] }, environments: { allow: ['SANDBOX'], deny: [] } } })
function load() {
  facts = new MeshSecurityStore(store)
  identities = new TrustedIdentityAuthority(facts, token => token === 'a' || token === 'b' ? { tenantId: token, actorRef: 'admin' } : undefined, lifetime.signal, () => clock)
  gate = new LocalSafetyGate(facts, lifetime.signal, () => clock)
  bindings = new SessionBindingAuthority(identities, facts, gate, id => targets.get(id), () => clock)
}
beforeEach(() => {
  directory = mkdtempSync(join(tmpdir(), 'mesh-bindings-')); file = join(directory, 'state.sqlite')
  store = new Store(file); clock = 1000; lifetime = new AbortController(); targets = new Map([['root', target()], ['child', target('root')]])
  load()
  for (const tenantId of ['a', 'b']) {
    facts.grant({ tenantId, actorRef: 'admin', roles: ['admin'], expiresAt: 2_000_000, version: 1 })
    facts.setPolicy({ tenantId, safetyPolicyVersion: 'v1', emergencyRevocationEpoch: 0 })
  }
})
afterEach(() => { store.close(); rmSync(directory, { recursive: true, force: true }) })

it('derives identity and bounded expiry from authenticated facts; retry and reopen preserve the exact grant', () => {
  const context = identities.authenticate('a'), first = bindings.issue(context, 'root')
  expect(first).toMatchObject({ tenantId: 'a', actorRef: 'admin', identityVersion: 1, expiresAt: 901000 })
  clock += 100
  expect(bindings.issue(context, 'root')).toEqual(first)
  store.close(); store = new Store(file); load()
  expect(bindings.restore(identities.authenticate('a'), 'root')).toEqual(first)
  expect(() => gate.assert('root', 'read', 'fixture', 'SANDBOX')).not.toThrow()
  expect(gate.executionReady()).toBe(false)
})
it('denies forged contexts, foreign tenant collisions, unmanaged IDs and scope changes without overwriting facts', () => {
  const a = identities.authenticate('a'), first = bindings.issue(a, 'root')
  expect(() => bindings.issue({ ...a }, 'root')).toThrow(MeshAccessDenied)
  expect(() => bindings.issue(identities.authenticate('b'), 'root')).toThrow(MeshAccessDenied)
  expect(() => bindings.issue(a, 'unknown')).toThrow(MeshAccessDenied)
  targets.set('root', { permissions: { ...target().permissions, tools: { allow: ['read', 'write'], deny: [] } } })
  expect(() => bindings.issue(a, 'root')).toThrow(MeshAccessDenied)
  expect(facts.binding('root')).toEqual(first)
})
it('narrows children to parent scope and expiry, and a durable parent tombstone revokes all descendants', () => {
  const a = identities.authenticate('a')
  bindings.issue(a, 'root'); clock += 100
  targets.set('child', { ...target('root'), permissions: { ...target().permissions, tools: { allow: ['read', 'write'], deny: [] } } })
  const child = bindings.issue(a, 'child')
  expect(child.expiresAt).toBe(901000)
  expect(child.current.tools.allow).toEqual(['read'])
  expect(() => gate.assert('child', 'write', 'fixture', 'SANDBOX')).toThrow()
  bindings.revoke(a, 'root')
  store.close(); store = new Store(file); load()
  expect(facts.binding('root')?.revoked).toBe(true)
  expect(() => bindings.restore(identities.authenticate('a'), 'child')).toThrow(MeshAccessDenied)
  expect(() => bindings.issue(identities.authenticate('a'), 'root')).toThrow(MeshAccessDenied)
  expect(() => gate.assert('child', 'read', 'fixture', 'SANDBOX')).toThrow()
})
it('does not renew expired or stale bindings, and refuses missing parents without leaving a partial row', () => {
  const a = identities.authenticate('a'); bindings.issue(a, 'root')
  clock = 901000
  expect(() => bindings.issue(a, 'root')).toThrow(MeshAccessDenied)
  clock = 1000
  facts.setPolicy({ tenantId: 'a', safetyPolicyVersion: 'v1', emergencyRevocationEpoch: 1 })
  expect(() => bindings.restore(identities.authenticate('a'), 'root')).toThrow(MeshAccessDenied)
  expect(() => bindings.issue(identities.authenticate('a'), 'child')).toThrow(MeshAccessDenied)
  expect(facts.binding('child')).toBeUndefined()
})
it('denies corrupted recovered expiry instead of treating null/missing timestamps as unbounded', () => {
  bindings.issue(identities.authenticate('a'), 'root')
  const corrupt = { ...facts.binding('root'), expiresAt: null }
  store.db.prepare('UPDATE mesh_session_security SET binding=? WHERE session_id=?').run(JSON.stringify(corrupt), 'root')
  expect(() => bindings.restore(identities.authenticate('a'), 'root')).toThrow(MeshAccessDenied)
  expect(() => gate.assert('root', 'read', 'fixture', 'SANDBOX')).toThrow()
})
it('denial audit failure cannot enter a direct gateway body, and stopped issuers cannot provision', () => {
  let entered = 0
  store.db.exec('DROP TABLE mesh_gate_audit')
  expect(() => { bindings.restore(identities.authenticate('a'), 'root'); entered++ }).toThrow(MeshAccessDenied)
  expect(entered).toBe(0)
  lifetime.abort()
  expect(() => bindings.issue(identities.authenticate('a'), 'root')).toThrow(MeshAccessDenied)
})

